# Skopiuj ten plik jako .env i uzupełnij wartości.
# Nigdy nie commituj .env do repozytorium.

# -- Podstawowe --
DEBUG=False
SECRET_KEY=<wygeneruj: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())">
ALLOWED_HOSTS=twoja-domena.pl,www.twoja-domena.pl

# -- Baza danych --
# SQLite (dev):  sqlite:///db.sqlite3
# PostgreSQL:    postgres://user:password@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# -- Szyfrowanie pól (django-encrypted-model-fields) --
# Wygeneruj: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=<klucz-fernet-base64>

# -- Opcjonalne --
# Limit rozmiaru pliku importu Excel (MB), domyślnie 10
# MAX_IMPORT_FILE_SIZE_MB=10
